# Exemple de configuration : copier ce fichier vers apps/portfolio-next/.env.local
# et remplacer les valeurs d'exemple. Ne jamais commiter de vraies valeurs.

# true : affiche les coordonnées d'exemple en production
REPO_PUBLIC=false

# Coordonnées (valeurs d'exemple)
CONTACT_EMAIL=contact@example.com
CONTACT_PHONE=+000 00 00 00 00
CONTACT_LOCATION=Ville, Pays

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Clé d'accès Web3Forms du formulaire de suggestion (facultative)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=votre-cle-web3forms
